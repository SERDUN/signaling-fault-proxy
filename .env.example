# signaling-fault-proxy - environment for the signup-as-login bench.
# Copy to .env (gitignored) and fill in. Never commit real credentials.

# The Core to forward to. Unset -> the offline stub Core in testbench/.
# SFP_UPSTREAM=https://core.example.com

# The account the custom signup logs in as, LOGIN:PASSWORD. Unset -> the stub's throwaway account.
# SFP_SIGNUP_AS_LOGIN=myaccount:mypassword
